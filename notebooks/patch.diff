+1 0.5 1 0.5
+"""
+
+# Write the test file exactly as described in the issue
+with open('test.qdp', 'w') as f:
+    f.write(qdp_content)
+
+print("Created test.qdp with exact content from issue description:")
+print(repr(qdp_content))
+
+# Try to read it exactly as shown in the issue
+try:
+    from astropy.table import Table
+    table = Table.read('test.qdp', format='ascii.qdp')
+    print("\nSUCCESS: Table read successfully!")
