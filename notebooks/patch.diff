+#!/usr/bin/env python3
+"""
+Comprehensive test script for QDP case sensitivity fix.
+Tests various case combinations of QDP commands.
+"""
+
+from astropy.table import Table
+import numpy as np
+
+def test_case_combination(command_text, description):
+    """Test a specific case combination of QDP commands."""
+    print(f"\nTesting {description}:")
+    print(f"Command: {command_text}")
+
+    # Create QDP content with the command
+    qdp_content = f"""{command_text}
+1 0.5 2 0.3
+"""
+
+    # Write test file
+    filename = f"test_{description.lower().replace(' ', '_').replace('/', '_')}.qdp"
+    with open(filename, 'w') as f:
+        f.write(qdp_content)
+
+    # Try to read it
+    try:
+        table = Table.read(filename, format='ascii.qdp')
+        print(f"SUCCESS: Table read successfully!")
+        print(f"Columns: {table.colnames}")
+        print(f"Data: {table}")
+        return True
+    except Exception as e:
+        print(f"ERROR: {e}")
+        return False
+
+# Test various case combinations
+test_cases = [
+    ("READ SERR 1 2", "uppercase READ SERR"),
+    ("read serr 1 2", "lowercase read serr"),
+    ("Read Serr 1 2", "mixed case Read Serr"),
+    ("READ TERR 1", "uppercase READ TERR"),
+    ("read terr 1", "lowercase read terr"),
+    ("Read Terr 1", "mixed case Read Terr"),
+    ("ReAd SeRr 1 2", "random case ReAd SeRr"),
+    ("rEaD tErR 1", "random case rEaD tErR"),
+]
+
+print("Testing various case combinations of QDP commands...")
+print("=" * 60)
+
+all_passed = True
+for command, description in test_cases:
+    passed = test_case_combination(command, description)
+    if not passed:
+        all_passed = False
+
+print("\n" + "=" * 60)
+if all_passed:
+    print("ALL TESTS PASSED: Case-insensitive parsing works correctly!")
+else:
+    print("SOME TESTS FAILED: There are issues with case-insensitive parsing.")
+
+# Test with multiple commands
+print("\nTesting multiple commands with mixed case:")
+multi_command_content = """Read Serr 1
+read terr 2
+3 0.1 4 0.2 -0.15
+"""
+
+with open('test_multi_commands.qdp', 'w') as f:
+    f.write(multi_command_content)
+
+try:
+    table = Table.read('test_multi_commands.qdp', format='ascii.qdp')
+    print("SUCCESS: Multiple mixed-case commands work!")
+    print(f"Columns: {table.colnames}")
+    print(f"Data shape: {len(table)} rows, {len(table.colnames)} columns")
+except Exception as e:
+    print(f"ERROR with multiple commands: {e}")
