+#!/usr/bin/env python3
+"""
+Script to reproduce the QDP case sensitivity issue.
+"""
+
+# Create a QDP file with lowercase commands as described in the issue
+qdp_content = """read serr 1 2
+1 0.5 1 0.5
+"""
+
+# Write the test file
+with open('test.qdp', 'w') as f:
+    f.write(qdp_content)
+
+print("Created test.qdp with lowercase commands:")
+print(qdp_content)
+
+# Try to read it with astropy
+try:
+    from astropy.table import Table
+    table = Table.read('test.qdp', format='ascii.qdp')
+    print("SUCCESS: Table read successfully!")
+    print(table)
+except Exception as e:
+    print(f"ERROR: {e}")
+    print("This confirms the issue - lowercase commands are not recognized.")
+
+# Also test with uppercase commands to confirm it works
+qdp_content_upper = """READ SERR 1 2
